# 复制成 .env 后填写真实值。.env 已在 .gitignore 里，不会被提交。
# docker compose 会自动读取同目录的 .env

# ---- 数据库（mysql profile）----
DB_NAME=edu_platform
DB_USER=root
DB_PASSWORD=请改成你自己的密码

# ---- 认证 ----
# 生成方式：openssl rand -hex 32
JWT_SECRET=请换成一串随机长字符串

# ---- 大模型（留空则 Agent 走 fallback 模式）----
AGENT_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat

# ---- 服务端口 ----
SERVER_PORT=8080
